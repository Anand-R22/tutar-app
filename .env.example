# ============================================
# TutAR Environment Variables
#
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to: .env
# 2. Fill in your real Pinecone key below
# 3. Never commit or share the .env file
#
# Embeddings run locally, so no embedding API key is needed.
# ============================================

# Pinecone API Key
# Get from: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=your_pinecone_key_here

# Pinecone Index Name (must match the index you created)
PINECONE_INDEX=tutar-models
